    {
      "name": "7. Create Showtime",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var tmr = new Date(); tmr.setDate(tmr.getDate() + 1);",
              "pm.environment.set('tomorrow', tmr.toISOString().slice(0, 19));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
