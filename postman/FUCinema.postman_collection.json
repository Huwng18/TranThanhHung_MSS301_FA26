    {
      "name": "11. Admin Report",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var today = new Date().toISOString().split('T')[0];",
              "pm.environment.set('todayDate', today);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway}}/api/bookings/report?startDate={{todayDate}}&endDate={{todayDate}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "bookings",
            "report"
          ],
          "query": [
            {
              "key": "startDate",
              "value": "{{todayDate}}"
            },
            {
              "key": "endDate",
              "value": "{{todayDate}}"
            }
          ]
        }
